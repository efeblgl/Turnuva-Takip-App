# =============================================================================
# Yığılca Futbol Turnuvası - Ortam Değişkenleri Örneği
# Bu dosyayı ".env.local" olarak kopyalayın ve kendi değerlerinizi girin.
# =============================================================================

# --- İstemci tarafında kullanılması güvenli anahtarlar -----------------------
# Supabase Dashboard -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://PROJENIZ.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# --- YALNIZCA SUNUCU TARAFI ---------------------------------------------------
# Bu anahtarları ASLA "NEXT_PUBLIC_" öneki ile yazmayın!
# Secret key: yönetici scriptleri için (ilk süper yönetici oluşturma vb.)
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXX

# Veritabanı bağlantı adresi: migration'ları çalıştırmak için
# Supabase Dashboard -> Connect -> Session pooler (URI)
SUPABASE_DB_URL=postgresql://postgres.PROJENIZ:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
